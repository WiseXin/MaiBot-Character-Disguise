{
  "manifest_version": 2,
  "id": "WiseXin.character-disguise",
  "version": "1.0.0",
  "name": "麦麦的人类伪装计划",
  "description": "告别机器人爹味与做题家说教！让麦麦像真人一样随性聊天：彻底去句号、极短随性断句、纯文本零Markdown、不当懂王不抢答、懂得知难而退与潜水窥屏，完美融入人类日常水群与私聊。",
  "author": {
    "name": "WiseXin",
    "url": "https://github.com/WiseXin"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/WiseXin/MaiBot-Character-Disguise",
    "homepage": "https://github.com/WiseXin/MaiBot-Character-Disguise",
    "documentation": "https://github.com/WiseXin/MaiBot-Character-Disguise#readme",
    "issues": "https://github.com/WiseXin/MaiBot-Character-Disguise/issues"
  },
  "host_application": {
    "min_version": "1.3.0",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.0.0",
    "max_version": "2.99.99"
  },
  "dependencies": [],
  "capabilities": [
    "send.text"
  ],
  "plugin_type": "extension",
  "display": {
    "icon": {
      "type": "lucide",
      "value": "user-check"
    }
  },
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  }
}
